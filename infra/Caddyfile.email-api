:{$PORT:80} {
  @health path /health
  handle @health {
    reverse_proxy {$BACKEND_UPSTREAM:backend:3000}
  }

  @api path /api/* /v1/*
  handle @api {
    reverse_proxy {$BACKEND_UPSTREAM:backend:3000}
  }

  handle {
    reverse_proxy {$ADMIN_UPSTREAM:admin:80}
  }

  log {
    output stdout
    format console
    level ERROR
  }
}
