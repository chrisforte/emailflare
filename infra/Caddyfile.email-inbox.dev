:{$PORT:80} {
  # API, webhook, and notification routes → inbox-server (Node.js)
  @backend path /api/* /webhook/* /v1/* /health
  handle @backend {
    reverse_proxy inbox-server:3002
  }

  # Vite dev server with HMR (WebSocket upgrades pass through automatically)
  handle {
    reverse_proxy inbox-ui:5174
  }

  log {
    output stdout
    format console
    level ERROR
  }
}
