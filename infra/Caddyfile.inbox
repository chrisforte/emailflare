:{$PORT:80} {
	# API, webhook, and send routes → inbox-server (Node.js)
	@backend path /api/* /webhook/* /v1/* /health
	handle @backend {
		reverse_proxy {$INBOX_SERVER_UPSTREAM:localhost:3002}
	}

	# WebSocket notifications — proxy upgrade must pass through
	@ws {
		path /api/notifications/ws
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy {$INBOX_SERVER_UPSTREAM:localhost:3002}
	}

	# Dashboard SPA — serve static files with SPA fallback
	handle {
		root * {$DASHBOARD_DIR:/app/inbox-ui/dist}
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
		level ERROR
	}
}
