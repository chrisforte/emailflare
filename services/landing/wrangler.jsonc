{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emailflare",
  "compatibility_date": "2026-04-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
