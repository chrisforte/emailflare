---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogUrl?: string;
  ogType?: string;
  navType?: 'home' | 'back' | 'docs';
  keywords?: string;
}

const {
  title,
  description = 'EmailFlare is a self-hosted email sending platform built on Cloudflare Email Sending. Clean REST API, domain management, scoped API keys, 50 React Email templates, and an admin UI — all in one Docker container.',
  canonical,
  ogUrl,
  ogType = 'website',
  navType = 'back',
  keywords,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="EmailFlare contributors" />
  <meta name="robots" content="index, follow" />
  {canonical && <link rel="canonical" href={canonical} />}

  <meta property="og:type" content={ogType} />
  {ogUrl && <meta property="og:url" content={ogUrl} />}
  <meta property="og:site_name" content="EmailFlare" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://emailflare.dev/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  {ogUrl && <meta name="twitter:url" content={ogUrl} />}
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://emailflare.dev/og.png" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />

  <slot name="head" />
  <script is:inline defer src="https://manage.anately.sh/script.js" data-website-id="c517f1e2-5f2c-4659-948e-659371cdeb46"></script>
</head>
<body>

  <nav>
    <div class="container">
      <div class="nav-inner">
        {navType === 'home' && (
          <Fragment>
            <a class="logo" href="/">
              <div class="logo-icon"><img src="/favicon.svg" alt="EmailFlare" width="30" height="30" /></div>
              <span class="logo-text">EmailFlare</span>
            </a>
            <ul class="nav-links">
              <li class="hide-mobile"><a href="#why">Why EmailFlare</a></li>
              <li class="hide-mobile"><a href="#features">Features</a></li>
              <li class="hide-mobile"><a href="/docs">Docs</a></li>
              <li class="hide-mobile"><a href="/cloudflare-token">CF Token</a></li>
              <li class="hide-mobile"><a href="/mesahub">MesaHub</a></li>
              <li class="hide-mobile"><a href="/cloudflare">Workers Deploy</a></li>
              <li><a href="https://github.com/0xdps/emailflare" target="_blank" rel="noopener">GitHub</a></li>
              <li><a class="nav-cta" href="#deploy">Self-host →</a></li>
            </ul>
          </Fragment>
        )}
        {navType === 'back' && (
          <Fragment>
            <a class="logo" href="/">
              <div class="logo-icon"><img src="/favicon.svg" alt="EmailFlare" width="30" height="30" /></div>
              <span class="logo-text">EmailFlare</span>
            </a>
            <a class="nav-back" href="/">← Back to home</a>
          </Fragment>
        )}
        {navType === 'docs' && (
          <Fragment>
            <a class="logo" href="/">
              <div class="logo-icon"><img src="/favicon.svg" alt="EmailFlare" width="30" height="30" /></div>
              <span class="logo-text">EmailFlare</span>
              <span class="logo-sep hide-mobile">/</span>
              <span class="logo-sub hide-mobile">Docs</span>
            </a>
            <div class="nav-right">
              <a class="nav-link" href="/#why">Why EmailFlare</a>
              <a class="nav-link" href="/#deploy">Self-host</a>
              <a class="nav-link" href="https://github.com/0xdps/emailflare" target="_blank" rel="noopener">GitHub</a>
            </div>
          </Fragment>
        )}
      </div>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="container">
      <div class="footer-inner">
        <div class="footer-copy">© 2025 EmailFlare contributors. MIT License.</div>
        <slot name="footer-links">
          <ul class="footer-links">
            <li><a href="https://github.com/0xdps/emailflare" target="_blank" rel="noopener">GitHub</a></li>
            <li><a href="/docs">Docs</a></li>
            <li><a href="https://github.com/0xdps/emailflare/blob/trunk/SECURITY.md" target="_blank" rel="noopener">Security</a></li>
            <li><a href="https://github.com/0xdps/emailflare/blob/trunk/LICENSE" target="_blank" rel="noopener">License</a></li>
          </ul>
        </slot>
      </div>
    </div>
  </footer>

  <slot name="scripts" />

</body>
</html>
