# emailflare inbox-server — environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.inbox.local, fill in values, then run:
#   just inbox-server-dev
#
# Lines starting with # are comments.
# .env.inbox.local is gitignored — never commit it.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
INBOX_SERVER_PORT=3002

# ── MesaHub (SQLite) ──────────────────────────────────────────────────────────
# Local dev: started by `just inbox-server-deps` (mesahub-inbox container).
# Token must match MESAHUB_ADMIN_TOKEN passed to compose.inbox.dev.yaml.
# For an external MesaHub: mh://apikey@host:port/inbox-db
MESAHUB_URL=mh://inbox-dev-token@localhost:3003/inbox-db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev: started by `just inbox-server-deps` (redis-inbox container).
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Used to sign session JWTs. Must be 32+ chars.
# In dev, env.ts uses a hard-coded fallback if this is empty — fine for local.
SESSION_SECRET=inbox-dev-session-secret-32chars-change-in-prod

# ── Inbound webhook ───────────────────────────────────────────────────────────
# Shared HMAC secret between inbox-bridge (CF Worker) and inbox-server.
# In dev you can POST to /webhook/email with this secret to simulate inbound mail.
WEBHOOK_SECRET=inbox-dev-webhook-secret-32chars-change

# ── Cloudflare Email API ──────────────────────────────────────────────────────
# Optional for local dev — email sending will log a warning and no-op.
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ── Cloudflare R2 (attachment storage) ────────────────────────────────────────
# Optional for local dev — attachments won't be stored but server starts fine.
# Get tokens from: Cloudflare dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=emailflare-inbox-attachments

# ── Migrations ────────────────────────────────────────────────────────────────
# Path to SQL migration files (relative to services/inbox-server/ working dir).
# The inbox CF Worker migrations are reused here.
MIGRATIONS_DIR=../inbox/migrations
