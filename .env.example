# ── Local docker-compose port ─────────────────────────────────────────────────
# Port the Caddy reverse proxy binds to on the host. The admin UI and API are
# both served from this port. Railway injects PORT automatically — leave as-is.
PORT=8090

# ── Session ───────────────────────────────────────────────────────────────────
# Secret used to sign HTTP session cookies. Must be at least 32 characters.
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-at-least-32-chars

# ── Admin token ──────────────────────────────────────────────────────────────
# Static bearer token for the admin UI and admin API routes. Must be at least
# 32 characters. Keep this secret — it grants full access to the admin panel.
# Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-in-production

# ── Mesahub connection ────────────────────────────────────────────────────────
# Controls where EmailFlare stores its data (API keys, templates, send logs).
# Embedded — mesahub-server runs inside the container (default for local/Railway):
MESAHUB_URL=mh://local/emailflare
# External — hosted or self-hosted mesahub instance:
# MESAHUB_URL=mh://shs_your_api_key@api.mesahub.app/your-db-slug

# ── Cloudflare ────────────────────────────────────────────────────────────────
# Required for production email sending via the Cloudflare Email Sending API.
# Not required if you only use test API keys (those route through SMTP instead).
# Scoped token needs: Zone.Email Routing (Edit) + Account.Email Sending (Edit)
# Guide: https://emailflare.dev/cloudflare-token
CF_API_TOKEN=
# Your Cloudflare account ID — found in the Cloudflare dashboard sidebar.
CF_ACCOUNT_ID=

# ── Test mode & Mailpit ──────────────────────────────────────────────────────
# Set ENABLE_TEST_MODE=true to start the bundled Mailpit SMTP catcher and expose
# it at /mailpit/ on the same port as the admin UI.
# When disabled (default) Mailpit is never started and the /mailpit/ route does
# not exist — no impact on production sends.
ENABLE_TEST_MODE=false

# Mailpit UI credentials (only used when ENABLE_TEST_MODE=true).
# Defaults: user=root, password=$ADMIN_TOKEN — set here to override.
# MAILPIT_USER=root
# MAILPIT_PASS=

# SMTP connection used by test API keys (eftest_ prefix).
# When ENABLE_TEST_MODE=true these are set automatically to the bundled Mailpit.
# Override to point at an external catcher (Mailtrap, MailHog, etc.).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# ── Railway / hosted deployment notes ─────────────────────────────────────────
# Set in your platform's environment settings:
#   NODE_ENV=production
#   ADMIN_TOKEN=<openssl rand -hex 32>
#   SESSION_SECRET=<openssl rand -hex 32>
#   MESAHUB_URL=mh://local/your-db-name   ← embedded, or use hosted URL
#   CF_API_TOKEN=...
#   CF_ACCOUNT_ID=...
#   PORT is injected automatically by Railway
#
# To enable Mailpit in a hosted deployment (e.g. for staging):
#   ENABLE_TEST_MODE=true
#   MAILPIT_USER=root          ← optional, defaults to root
#   MAILPIT_PASS=<secret>      ← optional, defaults to ADMIN_TOKEN
#   SMTP_HOST and SMTP_PORT are set automatically when ENABLE_TEST_MODE=true
