# ── Local docker-compose port ─────────────────────────────────────────────────
PORT=8090

# ── Session ───────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-at-least-32-chars

# ── Admin token ──────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-in-production

# ── Mesahub connection ────────────────────────────────────────────────────────
# Embedded — mesahub-server runs inside the container (default for local/Railway):
MESAHUB_URL=mh://local/emailflare
# External — hosted or self-hosted mesahub instance:
# MESAHUB_URL=mh://shs_your_api_key@api.mesahub.app/your-db-slug

# ── Cloudflare ────────────────────────────────────────────────────────────────
# Scoped token needs: Zone.Email Routing (Edit) + Account.Email Sending (Edit)
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ── Railway / hosted deployment notes ─────────────────────────────────────────
# Set in your platform's environment settings:
#   NODE_ENV=production
#   ADMIN_TOKEN=<openssl rand -hex 32>
#   SESSION_SECRET=<openssl rand -hex 32>
#   MESAHUB_URL=mh://local/your-db-name   ← embedded, or use hosted URL
#   CF_API_TOKEN=...
#   CF_ACCOUNT_ID=...
#   PORT is injected automatically by Railway
