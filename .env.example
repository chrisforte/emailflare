# ── Local docker-compose port ─────────────────────────────────────────────────
PORT=8090

# ── Session ───────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-at-least-32-chars

# ── Admin token ──────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-in-production

# ── SqliteHub / Mesahub ───────────────────────────────────────────────────────
# Hosted: get key at mesahub.app → Settings → API Keys
# Self-hosted: set SQLITE_HUB_API_URL to your own instance URL
SQLITE_HUB_API_KEY=shs_your_api_key_here
SQLITE_HUB_API_URL=https://api.mesahub.app
SQLITE_HUB_DB=emailflair

# ── Cloudflare ────────────────────────────────────────────────────────────────
# Scoped token needs: Zone.Email Routing (Edit) + Account.Email Sending (Edit)
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ── Railway deployment ────────────────────────────────────────────────────────
# Single service — root Dockerfile bundles admin (Caddy static) + backend (Node)
# start.sh starts Node on $BACKEND_PORT internally, Caddy on $PORT publicly
#
# Set these in Railway:
#   NODE_ENV=production
#   ADMIN_TOKEN=<openssl rand -hex 32>
#   SESSION_SECRET=<openssl rand -hex 32>
#   SQLITE_HUB_API_KEY=shs_...
#   CF_API_TOKEN=...
#   CF_ACCOUNT_ID=...
#   BACKEND_PORT=3001   (optional, default is 3001)
#   PORT is injected automatically by Railway
